rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /days/{dayId} {
      // Hanya user yang sudah login (via Firebase Auth) bisa baca & tulis
      allow read, write: if request.auth != null;
    }
    match /catalog/{itemId} {
      // Katalog — hanya user login yang bisa akses
      allow read, write: if request.auth != null;
    }
    match /inspirations/{docId} {
      // Kata semangat — hanya user login
      allow read, write: if request.auth != null;
    }
    match /countdowns/{docId} {
      // Countdown kustom — hanya user login
      allow read, write: if request.auth != null;
    }
    match /templates/{docId} {
      // Template jadwal — hanya user login
      allow read, write: if request.auth != null;
    }
  }
}
